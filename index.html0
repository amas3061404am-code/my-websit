<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>متجر سر السعادة</title>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF3EC;
    --plum:#432433;
    --plum-soft:#6b4456;
    --rose:#E9C3C8;
    --rose-deep:#B8677A;
    --gold:#C9A356;
    --gold-light:#EEDFB8;
    --sky:#BFE1E8;
    --line: rgba(201,163,86,0.35);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--cream);
    color:var(--plum);
    font-family:'Tajawal', sans-serif;
    line-height:1.9;
    overflow-x:hidden;
  }
  h1,h2,h3{ font-family:'Aref Ruqaa', serif; font-weight:700; color:var(--plum); }
  .eyebrow{
    font-size:.78rem; letter-spacing:.12em; color:var(--gold);
    font-weight:700; margin-bottom:.6rem; display:block;
  }
  .wrap{ max-width:1100px; margin:0 auto; padding:0 24px; }

  /* floral corner motif, reused */
  .corner{
    position:absolute; width:120px; height:120px; opacity:.55; pointer-events:none;
  }
  .corner svg{ width:100%; height:100%; }
  .corner.tl{ top:0; right:0; transform:scaleX(-1); }
  .corner.br{ bottom:0; left:0; transform:rotate(180deg) scaleX(-1); }

  /* ---------- HERO (Victorian banner) ---------- */
  .hero-victorian{
    position:relative;
    width:100%;
    line-height:0;
    border-bottom:1px solid var(--line);
  }
  .hero-victorian img{
    width:100%; height:auto; display:block;
  }
  .cta-bar{
    background:
      radial-gradient(circle at 15% 20%, rgba(201,163,86,.10), transparent 55%),
      radial-gradient(circle at 85% 80%, rgba(184,103,122,.10), transparent 55%),
      var(--cream);
    text-align:center;
    padding:38px 20px 44px;
    border-bottom:1px solid var(--line);
  }
  .cta-bar .flourish{ margin-bottom:20px; }
  .cta-bar p.tagline{
    font-family:'Aref Ruqaa', serif;
    font-size:1.3rem;
    color:var(--plum-soft);
    margin-bottom:22px;
  }
  .btn{
    display:inline-block;
    background:var(--rose-deep);
    color:#fff;
    padding:14px 38px;
    border-radius:2px;
    text-decoration:none;
    font-weight:700;
    letter-spacing:.04em;
    position:relative;
    border:1px solid var(--gold-light);
    transition:.25s;
  }
  .btn:hover{ background:#9c4f60; }
  .btn.ghost{
    background:transparent; border:1px solid rgba(255,255,255,.7); color:#fff;
    margin-inline-start:12px;
  }
  .btn.ghost-dark{
    background:transparent; border:1px solid var(--rose-deep); color:var(--rose-deep);
    margin-inline-start:12px;
  }
  .btn.ghost-dark:hover{ background:var(--rose-deep); color:#fff; }

  /* ---------- SECTION ENTRY TILES (icon links) ---------- */
  .entry-section{ padding:70px 0 80px; }
  .entry-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(190px, 1fr));
    gap:36px;
    max-width:820px; margin:0 auto;
  }
  .entry-tile{
    background:none; border:none; cursor:pointer;
    display:flex; flex-direction:column; align-items:center;
    text-align:center; font-family:inherit; padding:0;
  }
  .entry-icon{
    width:110px; height:110px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(160deg,#f6e9ee,#f0d9c8);
    border:3px double var(--gold);
    box-shadow:0 0 0 3px var(--cream), 0 0 0 4px var(--gold-light), 0 12px 26px -10px rgba(67,36,51,.35);
    margin-bottom:16px;
    transition:transform .3s ease, box-shadow .3s ease;
  }
  .entry-icon svg{ width:44px; height:44px; }
  .entry-tile:hover .entry-icon{
    transform:translateY(-5px);
    box-shadow:0 0 0 3px var(--cream), 0 0 0 4px var(--gold), 0 18px 32px -10px rgba(67,36,51,.4);
  }
  .entry-tile h3{ font-size:1.1rem; margin-bottom:4px; }
  .entry-tile p{ font-size:.8rem; color:var(--plum-soft); }

  /* ---------- DETAILS BUTTON on cards ---------- */
  .book-card, .guide-card{ cursor:pointer; }
  .details-btn{
    display:inline-block; background:none; border:none; cursor:pointer;
    font-family:inherit;
    font-size:.85rem; color:var(--rose-deep); font-weight:700;
    border-bottom:1px solid var(--rose-deep); padding-bottom:2px;
  }

  /* ---------- MODALS ---------- */
  .modal-overlay{
    display:none;
    position:fixed; inset:0; z-index:200;
    background:rgba(30,16,22,.72);
    padding:26px 16px;
    overflow-y:auto;
    align-items:flex-start; justify-content:center;
  }
  .modal-overlay.open{ display:flex; }
  .modal-box{
    background:var(--cream);
    max-width:520px; width:100%;
    margin:24px auto;
    border-radius:8px;
    border:1px solid var(--line);
    box-shadow:0 30px 60px -20px rgba(0,0,0,.5);
    overflow:hidden;
    position:relative;
    animation:modalIn .25s ease;
  }
  .modal-box.modal-wide{ max-width:900px; }
  @keyframes modalIn{ from{ opacity:0; transform:translateY(14px);} to{ opacity:1; transform:none; } }
  .modal-close{
    position:absolute; top:14px; left:14px; z-index:5;
    width:34px; height:34px; border-radius:50%;
    background:rgba(251,243,236,.9); border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; font-size:1.1rem; color:var(--plum);
  }
  .modal-cover{ width:100%; max-height:340px; object-fit:cover; object-position:top center; display:block; }
  .modal-body{ padding:28px 30px 34px; text-align:center; }
  .modal-body .tag{ font-size:.85rem; color:var(--gold); margin-bottom:.6rem; display:block; }
  .modal-body h3{ font-size:1.6rem; margin-bottom:.8rem; }
  .modal-body p.desc{ font-size:.98rem; color:var(--plum-soft); text-align:right; margin-bottom:24px; }
  .modal-body .modal-buy{
    display:inline-block; background:var(--rose-deep); color:#fff;
    padding:13px 34px; border-radius:2px; text-decoration:none;
    font-weight:700; border:1px solid var(--gold-light);
  }
  .modal-body .modal-buy:hover{ background:#9c4f60; }
  .modal-panel-inner{ padding:36px 20px 50px; }

  /* ---------- GUIDES ---------- */
  .guides-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(190px, 1fr));
    gap:34px;
  }
  .guide-card{ text-align:center; }
  .guide-card h4{ font-family:'Aref Ruqaa',serif; font-size:1.1rem; margin-bottom:.3rem; }
  .guide-card .tag{ font-size:.78rem; color:var(--gold); display:block; margin-bottom:.5rem; }

  /* ---------- SECTION SHELL ---------- */
  section{ position:relative; padding:90px 0; }
  .divider{
    width:1px; height:60px; background:var(--gold);
    margin:0 auto 40px; opacity:.6;
  }
  .divider::before, .divider::after{ content:''; }
  .section-head{ text-align:center; max-width:600px; margin:0 auto 60px; }
  .section-head h2{ font-size:2.2rem; margin-bottom:.7rem; }
  .section-head p{ color:var(--plum-soft); font-size:1.02rem; }

  /* ---------- OVAL FRAME (signature element) ---------- */
  .oval-frame{
    width:210px; height:270px; margin:0 auto 22px;
    border-radius:50% / 42%;
    border:6px double var(--gold);
    box-shadow:
      0 0 0 3px var(--cream),
      0 0 0 4px var(--gold-light),
      0 14px 30px -10px rgba(67,36,51,.35);
    overflow:hidden;
    position:relative;
    background:linear-gradient(160deg,#f6e9ee, #f0d9c8);
    display:flex; align-items:center; justify-content:center;
  }
  .oval-frame .placeholder-title{
    font-family:'Aref Ruqaa', serif;
    font-size:1.3rem;
    color:var(--rose-deep);
    text-align:center;
    padding:0 18px;
  }
  .oval-frame .cover-img{
    width:100%; height:100%; object-fit:cover; object-position:top center;
  }
  /* placeholder for a cover not yet supplied — glowing "light" motif */
  .cover-placeholder{
    width:100%; height:100%;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    background:radial-gradient(circle at 50% 35%, #3a3f66, #171a30 72%);
    color:var(--gold-light);
  }
  .cover-placeholder svg{ width:34px; height:34px; margin-bottom:10px; opacity:.9; }
  .cover-placeholder .placeholder-title{ color:var(--gold-light); }
  .cover-placeholder .placeholder-note{
    font-size:.68rem; color:rgba(238,223,184,.65); margin-top:6px; letter-spacing:.04em;
  }

  /* ---------- BOOKS ---------- */
  .books-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px, 1fr));
    gap:46px;
  }
  .book-card{ text-align:center; }
  .book-card h3{ font-size:1.4rem; margin-bottom:.3rem; }
  .book-card .tag{ font-size:.85rem; color:var(--gold); margin-bottom:.8rem; display:block; }
  .book-card p.blurb{
    font-size:.92rem; color:var(--plum-soft);
    max-height:120px; overflow:hidden; position:relative;
    margin-bottom:14px;
  }
  .book-card p.blurb::after{
    content:''; position:absolute; bottom:0; left:0; right:0; height:36px;
    background:linear-gradient(transparent, var(--cream));
  }
  .book-card .buy{
    font-size:.85rem; color:var(--rose-deep); font-weight:700;
    border-bottom:1px solid var(--rose-deep); padding-bottom:2px;
    text-decoration:none;
  }

  /* per-book cover tint */
  .cover-sr-alsaada{ background:linear-gradient(160deg,#f6e6ea,#eecdd3); }
  .cover-sana{ background:linear-gradient(160deg,#e9f0ee,#cfe3de); }
  .cover-orasil{ background:linear-gradient(160deg,#e6ecf2,#c9d6e6); }
  .cover-oryan{ background:linear-gradient(160deg,#f2e9d6,#e0c896); }

  /* ---------- CHILDREN / STICKERS ---------- */
  .kids-section{ background:linear-gradient(180deg,var(--cream), #fdf6ee); }
  .kids-banner-wrap{
    max-width:1100px; margin:0 auto 60px; padding:0 24px;
  }
  .kids-banner-wrap img{
    width:100%; height:auto; display:block; border-radius:6px;
    border:1px solid var(--line);
    box-shadow:0 18px 40px -18px rgba(67,36,51,.35);
  }
  .char-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
    gap:34px;
    max-width:760px; margin:0 auto 70px;
  }
  .char-card{ text-align:center; }
  .char-frame{
    width:150px; height:150px; margin:0 auto 14px;
    border-radius:50%;
    border:4px solid var(--gold);
    box-shadow:0 0 0 3px var(--cream), 0 0 0 4px var(--gold-light), 0 10px 22px -8px rgba(67,36,51,.3);
    overflow:hidden;
    background:#fff;
  }
  .char-frame img{ width:100%; height:100%; object-fit:cover; object-position:top center; }
  .char-card h4{ font-family:'Aref Ruqaa',serif; font-size:1.05rem; }
  .kids-sub-eyebrow{
    text-align:center; display:block; margin-bottom:26px;
    font-size:.78rem; letter-spacing:.1em; color:var(--gold); font-weight:700;
  }
  .sticker-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
    gap:34px;
  }
  .sticker-card{ text-align:center; }
  .sticker-circle{
    width:130px; height:130px; border-radius:50%;
    margin:0 auto 16px;
    background:var(--rose);
    border:4px solid var(--gold);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 22px -8px rgba(67,36,51,.3);
  }
  .sticker-circle svg{ width:60px; height:60px; }
  @media (max-width:560px){
    .modal-body{ padding:22px 20px 28px; }
    .modal-body h3{ font-size:1.35rem; }
  }
  .sticker-card h4{ font-family:'Aref Ruqaa',serif; font-size:1.15rem; margin-bottom:.4rem; }
  .sticker-card p{ font-size:.85rem; color:var(--plum-soft); }

  /* ---------- ABOUT ---------- */
  .about{
    display:grid;
    grid-template-columns:260px 1fr;
    gap:60px;
    align-items:center;
  }
  .about-portrait{
    width:100%; aspect-ratio:3/4;
    border-radius:50% / 42%;
    border:6px double var(--gold);
    box-shadow:0 0 0 3px var(--cream), 0 0 0 4px var(--gold-light);
    background:
      radial-gradient(circle at 30% 20%, #f7e3ea, transparent 60%),
      linear-gradient(160deg,#f4e2d8,#e9c7cf);
    display:flex; align-items:center; justify-content:center;
    padding:20px; text-align:center;
  }
  .about-portrait span{ font-family:'Aref Ruqaa',serif; color:var(--rose-deep); font-size:1.1rem; }
  .about-text p{ margin-bottom:1rem; font-size:1.02rem; }
  .about-text .signature{ font-family:'Aref Ruqaa', serif; font-size:1.3rem; color:var(--gold); margin-top:1.4rem; }

  @media (max-width: 720px){
    .about{ grid-template-columns:1fr; text-align:center; }
    .about-portrait{ max-width:220px; margin:0 auto; }
  }

  /* ---------- FOOTER ---------- */
  footer{
    background:var(--plum); color:#f3e6d8;
    text-align:center; padding:50px 20px 30px;
  }
  footer h3{ color:#fff; font-size:1.4rem; margin-bottom:10px; }
  footer .links{ margin:18px 0; }
  footer .links a{
    color:#f3e6d8; text-decoration:none; margin:0 10px; font-size:.9rem;
    border-bottom:1px solid transparent;
  }
  footer .links a:hover{ border-color:var(--gold); }
  footer .fine{ font-size:.78rem; color:#cbb6a3; margin-top:20px; }

  .note-banner{
    background:var(--gold-light); color:#5c4720;
    text-align:center; font-size:.85rem; padding:10px 16px;
  }

  /* ---------- NAV ---------- */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(251,243,236,.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    height:64px; position:relative;
  }
  .brand{ font-family:'Aref Ruqaa', serif; font-size:1.3rem; color:var(--plum); text-decoration:none; }
  .brand span{ color:var(--rose-deep); }
  .nav-links{ display:flex; gap:28px; list-style:none; }
  .nav-links a{
    color:var(--plum); text-decoration:none; font-size:.92rem;
    position:relative; padding-bottom:4px;
  }
  .nav-links a::after{
    content:''; position:absolute; right:0; bottom:0; width:0; height:1px;
    background:var(--gold); transition:.25s;
  }
  .nav-links a:hover::after{ width:100%; }
  .burger{ display:none; flex-direction:column; gap:5px; cursor:pointer; background:none; border:none; }
  .burger span{ width:24px; height:2px; background:var(--plum); display:block; }
  @media (max-width:720px){
    .nav-links{
      position:absolute; inset-inline:0; top:64px;
      background:var(--cream); flex-direction:column; gap:0;
      max-height:0; overflow:hidden; transition:.3s;
      border-bottom:1px solid var(--line);
    }
    .nav-links.open{ max-height:220px; }
    .nav-links li{ padding:14px 24px; border-top:1px solid var(--line); }
    .burger{ display:flex; }
  }

  /* ---------- FLOURISH DIVIDER ---------- */
  .flourish{ display:flex; align-items:center; justify-content:center; gap:14px; margin-bottom:14px; }
  .flourish .line{ width:50px; height:1px; background:var(--gold); opacity:.7; }
  .flourish svg{ width:18px; height:18px; }

  /* ---------- reveal-on-scroll (subtle) ---------- */
  .reveal{ opacity:0; transform:translateY(18px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.in{ opacity:1; transform:none; }

  /* card hover lift */
  .book-card, .sticker-card{ transition:transform .3s ease; }
  .book-card:hover, .sticker-card:hover{ transform:translateY(-6px); }
  .oval-frame, .sticker-circle{ transition:box-shadow .3s ease; }
  .book-card:hover .oval-frame{ box-shadow:0 0 0 3px var(--cream), 0 0 0 4px var(--gold), 0 20px 34px -10px rgba(67,36,51,.4); }
  .sticker-card:hover .sticker-circle{ box-shadow:0 14px 26px -8px rgba(67,36,51,.4); }
</style>
</head>
<body>

<div class="note-banner">
  معاينة تصميم — اضغطي على أي كتاب لعرض نبذته ثم الشراء عبر الفان. غلاف «أورياسيل» ومحتوى «المفكرات والأدلة» لا يزالان بانتظار الملفات النهائية
</div>

<nav>
  <div class="wrap">
    <a href="#" class="brand">سرّ <span>السعادة</span></a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#books">الكتب</a></li>
      <li><a href="#" onclick="openKidsModal(); return false;">عالم الأطفال</a></li>
      <li><a href="#" onclick="openGuidesModal(); return false;">المفكرات والأدلة</a></li>
      <li><a href="#about">من أنا</a></li>
    </ul>
    <button class="burger" id="burgerBtn" aria-label="القائمة">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- HERO : Victorian banner -->
<section class="hero-victorian">
  <!-- (يحتوي الجزء المتبقي من الكود هنا) -->
</section>
</body>
</html>
